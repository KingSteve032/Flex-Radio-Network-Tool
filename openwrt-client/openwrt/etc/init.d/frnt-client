#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=15

PROG=/usr/bin/frnt-openwrt-client

start_service() {
	local server lan_interface vpn_interface netbird_routes
	config_load frnt-client
	config_get server main server ''
	config_get netbird_routes main netbird_routes '0'
	config_get vpn_interface main vpn_interface 'wt0'
	config_get lan_interface main lan_interface 'br-lan'

	if [ -z "$lan_interface" ] || [ -z "$vpn_interface" ]; then
		echo "FRNT: LAN and NetBird interfaces must be configured"
		return 1
	fi
	if [ "$netbird_routes" = '1' ] && [ -n "$server" ]; then
		echo "FRNT: choose either server IP or automatic NetBird routes"
		return 1
	fi
	if [ "$netbird_routes" != '1' ] && [ -z "$server" ]; then
		echo "FRNT: set the server VPN IP or enable netbird_routes=1"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -lan-iface "$lan_interface" -vpn-iface "$vpn_interface"
	if [ "$netbird_routes" = '1' ]; then
		procd_append_param command -netbird-routes
	else
		procd_append_param command -server "$server"
	fi
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger frnt-client
}
